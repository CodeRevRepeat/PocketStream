<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_card_focused_top"
                android:endColor="@color/glass_card_focused_bottom" />
            <stroke
                android:width="2.5dp"
                android:color="@color/glass_stroke_focused" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_card_bg_top"
                android:endColor="@color/glass_card_bg_bottom" />
            <stroke
                android:width="1.2dp"
                android:color="@color/glass_stroke_unfocused" />
        </shape>
    </item>
</selector>
