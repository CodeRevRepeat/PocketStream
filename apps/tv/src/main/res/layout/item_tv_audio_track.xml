<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:minWidth="280dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_tv_audio_track_item_selector"
    android:stateListAnimator="@animator/tv_focus_scale"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvAudioTrackCheck"
        android:layout_width="26dp"
        android:layout_height="wrap_content"
        android:text="&#x2713;"
        android:textColor="@color/tv_accent_cyan"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvAudioTrackTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true" />

</LinearLayout>
