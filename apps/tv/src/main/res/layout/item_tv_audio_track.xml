<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:minWidth="240dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_tv_glass_button_selector"
    android:stateListAnimator="@animator/tv_focus_scale"
    android:focusable="true"
    android:clickable="true"
    android:gravity="center_vertical"
    android:paddingHorizontal="14dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvAudioTrackCheck"
        android:layout_width="22dp"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textColor="@color/tv_accent_cyan"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/tvAudioTrackTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:textColor="@color/color_tv_glass_button_text"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true" />

</LinearLayout>
