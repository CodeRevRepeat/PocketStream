<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_bg"
    android:gravity="center_horizontal">

    <ProgressBar
        android:id="@+id/pbPreparingSpinner"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/accent_cyan"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPreparingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preparing Video for TV"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPreparingSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rendering and buffering with hardware encoder to ensure smooth, stutter-free playback on your TV."
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvPreparingCountdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Starting stream in 30s..."
        android:textColor="@color/accent_cyan"
        android:textSize="15sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp" />

    <ProgressBar
        android:id="@+id/pbPreparingCountdown"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="30"
        android:progress="0"
        android:progressTint="@color/accent_cyan"
        android:progressBackgroundTint="@color/card_border"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvPreparingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hardware Transcode: 0%"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnCancelPreparing"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:backgroundTint="@color/card_border"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

</LinearLayout>
