<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Main Content Container: Swapped to horizontal in landscape, vertical in portrait -->
    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Left / Top Column: Header, Server Card, TV Card, SAF Buttons (Wrapped in NestedScrollView for safe scrolling on any screen size) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollLeftColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutLeftColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header -->
                <LinearLayout
                    android:id="@+id/layoutHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="POCKETSTREAM"
                        android:textColor="@color/accent_cyan"
                        android:textSize="18sp"
                        android:letterSpacing="0.1"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeviceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone Server"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Server Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardServerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Media server"
                                android:textColor="@color/text_primary"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <!-- Server Toggle Spinner -->
                            <ProgressBar
                                android:id="@+id/pbServerToggleLoading"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_marginEnd="10dp"
                                android:indeterminate="true"
                                android:indeterminateTint="@color/accent_purple"
                                android:visibility="gone" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnToggleServer"
                                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="38dp"
                                android:text="Stop"
                                android:textAllCaps="false"
                                android:textSize="13sp"
                                app:backgroundTint="@color/accent_purple"
                                app:cornerRadius="12dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_status_badge"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="RUNNING"
                                android:textColor="@color/accent_green"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvServerAddress"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Server offline"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TV Connection & Pairing Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTvConnection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTvTargetName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Target TV"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTvTargetStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Searching for TV or tap Scan..."
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnScanTvQr"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:text="Scan TV QR"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            app:backgroundTint="@color/accent_cyan"
                            android:textColor="#080D1A"
                            app:cornerRadius="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Storage Access / Add Buttons -->
                <LinearLayout
                    android:id="@+id/layoutStorageButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickFolder"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="+ Select Folder (SAF)"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/accent_cyan"
                        app:strokeColor="@color/accent_cyan"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPickFiles"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="+ Add Video File"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/text_primary"
                        app:strokeColor="@color/card_border"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Scan Progress Indicator -->
                <LinearLayout
                    android:id="@+id/layoutScanProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/accent_cyan" />

                    <TextView
                        android:id="@+id/tvScanProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Scanning videos in folder..."
                        android:textColor="@color/accent_cyan"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Right / Bottom Column: Video Library, Selection Toolbar, RecyclerView -->
        <LinearLayout
            android:id="@+id/layoutRightColumn"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Library Section Title & Selection Bar -->
            <LinearLayout
                android:id="@+id/layoutLibraryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Video library"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVideoCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 videos"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginEnd="10dp" />

                <!-- Select / Manage Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleManageMode"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Select"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_cyan"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Selection Actions Toolbar (Select All / Remove Selected / Cancel) -->
            <LinearLayout
                android:id="@+id/layoutSelectionToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Select All"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/card_border"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoveSelected"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="Remove (0)"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="#EF4444"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelSelection"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="Done"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvEmptyLibrary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No videos selected. Tap 'Select Folder' or 'Add Video File' to expose media to your TV."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMediaList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Phase 3: Now Playing & TV Remote Control Card (The Playback Slider Menu) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/accent_purple"
        app:strokeWidth="1dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/layoutNowPlayingInner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvNowPlayingBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TV PLAYING"
                    android:textColor="@color/accent_green"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:background="#132E24"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvNowPlayingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Video Title"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/tvNowPlayingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00 / 00:00"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Playback Scrubber Slider -->
            <SeekBar
                android:id="@+id/sbRemoteScrubber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:max="1000"
                android:progress="0"
                android:thumbTint="@color/accent_cyan"
                android:progressTint="@color/accent_cyan" />

            <!-- Remote Controls: Restart, -10s, Play/Pause, +10s, Stop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:weightSum="5"
                android:layout_marginTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoteRestart"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="|&lt;&lt; Start"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoteRw"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="-10s"
                    android:textSize="11sp"
                    android:textColor="@color/accent_cyan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemotePlayPause"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="Pause"
                    android:textSize="12sp"
                    app:backgroundTint="@color/accent_purple"
                    app:cornerRadius="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoteFf"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="+10s"
                    android:textSize="11sp"
                    android:textColor="@color/accent_cyan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRemoteStop"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:text="Stop"
                    android:textSize="11sp"
                    android:textColor="#EF4444" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
